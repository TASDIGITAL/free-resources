{
  // Cloudflare Worker config for the free-resources site.
  // index.html is served as a static asset; worker.js adds /api/resources
  // and injects the resource-link wiring script into HTML pages.
  "name": "free-resources",
  "main": "worker.js",
  "compatibility_date": "2026-06-11",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // Let the Worker run before serving these paths, so HTML responses
    // can be transformed (script injection). Other assets are served
    // directly from the edge.
    "run_worker_first": ["/", "/index.html"]
  },
  "observability": {
    "enabled": true
  }
}
